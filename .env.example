# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# MongoDB Connection
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/axion

# Email Configuration (for sending diagnostic submissions to admin)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Axion Index <support@axionindex.org>"
# Every form submission (diagnostic, AI Edge diagnostic, written intent) is emailed here
ADMIN_EMAIL=nitin@axionindex.org

# Accounts are off unless this is "true": no login/registration, no user panel (/user),
# no admin panel (/admin). Forms ask for name / email / mobile and are emailed to ADMIN_EMAIL.
NEXT_PUBLIC_PANELS_ENABLED=false

# Global AI Report: set to "true" on launch day (20 Nov) to publish the full report page
NEXT_PUBLIC_REPORT_PUBLISHED=false
# Optional: lets the team preview the hidden report at /global-ai-report/edition-01?preview=<key>
REPORT_PREVIEW_KEY=

# Razorpay (paid plan checkout — only used by the user panel)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Fix Brief Part 4 (see docs/forms-and-leads.md) ──
# Leads sheet: the Apps Script web app URL and the shared secret in scripts/leads-sheet/Code.gs
LEADS_SHEET_URL=
LEADS_SHEET_SECRET=
# Optional: AI Edge Lab interest in its own sheet (otherwise an "AI Edge Lab" tab of the leads file)
AI_EDGE_SHEET_URL=
# Analytics: set ONE of these (Plausible needs no cookie banner)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
# AI Edge Lab's own website (Fix Brief Part 5). Leave empty until it launches; then set it and rebuild.
NEXT_PUBLIC_AI_EDGE_LAB_URL=
# Live LinkedIn feed widget (Fix Brief Part 6, docs/linkedin.md): elfsight:<id> or curator:<feed id>
NEXT_PUBLIC_LINKEDIN_FEED_HOME=
NEXT_PUBLIC_LINKEDIN_FEED_FOUNDER=
# Studio (Fix Brief Part 7): lets scripts/import-library.mjs refresh the site after a bulk import.
# A long random value, e.g. `openssl rand -hex 24`. The Studio itself does not need it.
LIBRARY_REVALIDATE_SECRET=
# Preview copy of the site (Fix Brief Part 9, docs/access.md): never indexed, shows a "Preview" badge.
# Set only on the preview server: NEXT_PUBLIC_SITE_ENV=preview
NEXT_PUBLIC_SITE_ENV=
# Calendar booking link (Fix Brief Part 10, G-09): added to each conversation alert for Nitin's reply; never shown on the site
BOOKING_URL=
