# MongoDB Connection
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/axion

# Email Configuration (for sending diagnostic submissions to admin)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=no-reply@axion.com
ADMIN_EMAIL=admin@axion.com
