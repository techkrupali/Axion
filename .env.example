# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# MongoDB Connection
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/axion

# Email Configuration (for sending diagnostic submissions to admin)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=no-reply@axion.com
# Every form submission (diagnostic, AI Edge diagnostic, written intent) is emailed here
ADMIN_EMAIL=nitin@axionindex.org

# Accounts are off unless this is "true": no login/registration, no user panel (/user),
# no admin panel (/admin). Forms ask for name / email / mobile and are emailed to ADMIN_EMAIL.
NEXT_PUBLIC_PANELS_ENABLED=false

# Razorpay (paid plan checkout — only used by the user panel)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
